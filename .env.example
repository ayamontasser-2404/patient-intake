# Local development only. Never commit real secrets.
# Phase 1 reads PORT and WEB_ORIGIN only.
# The remaining variables are reserved for later phases and are unused until those features exist.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=file:./data/smart-patient-intake.db
UPLOAD_DIR=./private-uploads
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=5

# Default should be mock. Real provider integration is optional and must be configured server-side.
AI_PROVIDER=mock

# Example placeholders only. Do not add credentials to this file.
# BEDROCK_REGION=
# BEDROCK_MODEL_ID=
# AWS_PROFILE=
